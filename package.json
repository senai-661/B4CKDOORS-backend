{
  "name": "grena-api",
  "version": "1.1.0",
  "description": "API REST do projeto Grená (B4CKDOORS): catálogo, usuários, pedidos, autenticação JWT e controle de acesso por role.",
  "main": "dist/app.js",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "dev": "tsx watch src/app.ts",
    "build": "tsc",
    "start": "node dist/app.js",
    "db:init": "node scripts/init-db.mjs",
    "hash": "node scripts/gerar-hash.mjs"
  },
  "keywords": ["grena", "b4ckdoors", "express", "postgresql", "jwt"],
  "license": "ISC",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.19.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.18.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.3"
  }
}
